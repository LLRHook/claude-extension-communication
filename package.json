{
  "name": "blade-bridge",
  "version": "1.0.0",
  "description": "CLI-to-Chrome-extension bridge with a Rust Native Messaging host",
  "main": "blade.js",
  "bin": {
    "blade-bridge": "./blade.js"
  },
  "scripts": {
    "build:host": "node scripts/build-host.js",
    "prepack": "npm run build:host",
    "test": "node --test",
    "test:rust": "cargo test --locked --manifest-path native/Cargo.toml",
    "postinstall": "node scripts/ensure-host.js"
  },
  "keywords": [
    "chrome",
    "extension",
    "native-messaging",
    "cli",
    "bridge",
    "ipc",
    "chrome-extension",
    "devtools"
  ],
  "author": "Victor Ivanov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anthropics/blade-bridge.git"
  },
  "homepage": "https://github.com/anthropics/blade-bridge#readme",
  "bugs": {
    "url": "https://github.com/anthropics/blade-bridge/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "blade.js",
    "src/",
    "scripts/",
    "native/Cargo.toml",
    "native/Cargo.lock",
    "native/src/",
    "native/bin/",
    "extension/"
  ]
}
